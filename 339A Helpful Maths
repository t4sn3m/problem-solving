
#include <bits/stdc++.h>
using namespace std;
int main()
{
    string s;
    cin>>s;
    vector<char> nums;

    for(int i=0;i<s.length();i++)
    {
        if(s[i]!='+'){
            nums.push_back(s[i]);
        }
    }
    sort(nums.begin(), nums.end());

    for(int j=0;j<nums.size();j++)
    {
        if(j>0)
        cout<<"+";
        
        cout<<nums[j];
        
    }
    return 0;
}